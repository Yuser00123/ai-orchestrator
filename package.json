{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tool-calling agent orchestrator: owns the agent loop, tool plane (built-ins + E2B sandbox + MCP), sessions, runs. Model access exclusively via the Unified AI Memory Gateway.",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:arch": "node scripts/check-boundaries.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "spike:gateway": "node scripts/gateway-spike.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "dotenv": "^16.4.5",
    "e2b": "^1.5.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
