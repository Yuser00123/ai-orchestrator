# ── server ────────────────────────────────────────────────────────────────
PORT=8788
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# ── auth ──────────────────────────────────────────────────────────────────
# Required in production; any client uses "Bearer <master>" (admin) or issued ok_ keys
ORCH_MASTER_KEY=change-me-to-at-least-16-random-chars

# ── gateway (the ONLY model path) ─────────────────────────────────────────
GATEWAY_BASE_URL=https://ai-api-unifier.onrender.com
GATEWAY_API_KEY=
# development/testing only: deterministic mock, no gateway calls
LLM_MODE=gateway
GATEWAY_REQUEST_TIMEOUT_MS=120000
GATEWAY_MAX_RETRIES=3
GATEWAY_MAX_CALLS_PER_RUN=25

# ── persistence (Neon Postgres; empty → in-memory store, dev only) ───────
DATABASE_URL=
DB_POOL_MAX=5

# ── E2B sandbox ───────────────────────────────────────────────────────────
E2B_API_KEY=
E2B_TEMPLATE=base
E2B_IDLE_TTL_MS=600000
E2B_MAX_SESSION_MS=3300000
SANDBOX_MINUTES_PER_USER_DAY=30

# ── MCP server credentials (servers self-disable when their env is unset) ─
MCP_TAVILY_API_KEY=
MCP_BROWSERLESS_TOKEN=
MCP_AZURE_VISION_TOKEN=
MCP_AZURE_DOC_TOKEN=
# pollinations MCP now REQUIRES a key (endpoint answers 401 without one, verified 2026-10-01)
MCP_POLLINATIONS_KEY=
MCP_GITHUB_PAT=
MCP_CLOUDFLARE_TOKEN=
# cloudinary uses its canonical URL format, not basic auth:
MCP_CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
MCP_NEON_KEY=

# ── misc ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
CONFIG_DIR=./config
DATA_DIR=./data
# optional, for skills sync rate limits (60 req/h anonymous otherwise)
GITHUB_TOKEN=
